# P106-100 (6 ГБ). Скопируй в .env:  cp .env.example .env

MAIN_ADDRESS=0x_ВСТАВЬ_СВОЙ_АДРЕС
VLESS_URL=vless://ВСТАВЬ_СВОЮ_ССЫЛКУ

FIXED_BATCH_SIZE=64
TAG_BATCH_SIZE=15
# Pascal: fp16 ~в 64 раза медленнее fp32 — только float32
BPIPE_TORCH_DTYPE=float32

# пусто = языковой фильтр collector выключен (иначе не-en режется до перевода)
LANG_FILTER=

UPIPE_WORKERS=6
TRANSLATOR_MAX_BATCH=8
MAX_TRANSLATE_SRC_TOKENS=600
BPIPE_REPLICAS=1

USE_PROXY_TRANSLATOR=false
USE_PROXY_BPIPE=false
USE_PROXY_UPIPE=false

# VPN_DISABLE_PQV=true
